<%- include('includes/head.ejs') %>

<%- include('includes/sidebar.ejs') %>

      <!-- ========== ADMIN MAIN CONTENT ========== -->
      <main class="admin-main">
        <!-- Top Bar -->
        <div class="admin-topbar">
          <h1>All Products</h1>
          <div class="admin-user">
            <span>Welcome, <strong>Admin</strong></span>
            <div class="admin-avatar">A</div>
          </div>
        </div>

        <!-- Actions Bar -->
        <div class="admin-card">
          <div class="admin-card-header">
            <h3>
              Product Inventory
              <span
                class="text-muted"
                style="font-weight: 400; font-size: 0.9rem"
                >- <%=total %> products</span
              >
            </h3>
            <a href="/admin/add-product" class="btn btn-primary btn-sm"
              ><i class="fa-solid fa-plus"></i> Add Product</a
            >
          </div>

          <% if(products.length > 0) { %>
            <!-- Products Table -->
            <div class="table-responsive">
              <table class="data-table">
              <thead>
                <tr>
                  <th>Image</th>
                  <th>Product Name</th>
                  <th>Category</th>
                  <th>Price</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% for (let product of products) { %>
                <tr>
                  <td>
                    <div class="table-img">
                      <img
                        src="<%= product.imageUrl %>"
                        alt="<%= product.title %>"
                      />
                    </div>
                  </td>
                  <td><strong><%= product.title %></strong></td>
                  <td><%= product.category %></td>
                  <td><%= product.price %></td>
                  <td>
                    <div class="table-actions">
                      <a
                        href="/admin/products/<%= product.id %>/edit"
                        class="action-btn edit"
                        title="Edit"
                        ><i class="fa-solid fa-pen-to-square"></i
                      ></a>
                      <form
                        method="POST"
                        action="/admin/products/<%= product.id %>/delete"
                        style="display: inline"
                      >
                        <button
                          type="submit"
                          class="action-btn delete"
                          title="Delete"
                        >
                          <i class="fa-solid fa-trash"></i>
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
                <%}%>
              </tbody>
            </table>
          </div>
          <% } else { %>
            <h1> No Product</h1>
            <% } %>

          <!-- Pagination -->
          <nav class="pagination" aria-label="Products pagination">
            <a href="#">&laquo;</a>
            <span class="active">1</span>
            <a href="#">2</a>
            <a href="#">&raquo;</a>
          </nav>
        </div>
      </main>

<%- include('includes/end.ejs') %>