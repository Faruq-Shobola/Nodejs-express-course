<%- include('includes/head.ejs') %>

<%- include('includes/sidebar.ejs') %>

      <!-- ========== ADMIN MAIN CONTENT ========== -->
      <main class="admin-main">
        <!-- Top Bar -->
        <div class="admin-topbar">
          <h1>All Products</h1>
          <div class="admin-user">
            <span>Welcome, <strong>Admin</strong></span>
            <div class="admin-avatar">A</div>
          </div>
        </div>

        <!-- Actions Bar -->
        <div class="admin-card">
          <div class="admin-card-header">
            <h3>
              Product Inventory
              <span
                class="text-muted"
                style="font-weight: 400; font-size: 0.9rem"
                >- <%=total %> products</span
              >
            </h3>
            <a href="/admin/add-product" class="btn btn-primary btn-sm"
              ><i class="fa-solid fa-plus"></i> Add Product</a
            >
          </div>

          <% if(products.length > 0) { %>
            <!-- Products Table -->
            <div class="table-responsive">
              <table class="data-table">
              <thead>
                <tr>
                  <th>Image</th>
                  <th>Product Name</th>
                  <th>Category</th>
                  <th>Price</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% for (let product of products) { %>
                <tr>
                  <td>
                    <div class="table-img">
                      <img
                        src="<%= product.imageUrl %>"
                        alt="<%= product.title %>"
                      />
                    </div>
                  </td>
                  <td><strong><%= product.title %></strong></td>
                  <td><%= product.category %></td>
                  <td><%= product.price %></td>
                  <td>
                    <div class="table-actions">
                      <a
                        href="/admin/products/<%= product._id %>/edit"
                        class="action-btn edit"
                        title="Edit"
                        ><i class="fa-solid fa-pen-to-square"></i
                      ></a>
                      <form
                        method="POST"
                        action="/admin/products/<%= product._id %>/delete"
                        style="display: inline"
                      >
                        <button
                          type="submit"
                          class="action-btn delete"
                          title="Delete"
                          data-delete-trigger
                          data-product-title="<%= product.title %>"
                        >
                          <i class="fa-solid fa-trash"></i>
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
                <%}%>
              </tbody>
            </table>
          </div>
          <% } else { %>
            <h1> No Product</h1>
            <% } %>

          <!-- Pagination -->
          <nav class="pagination" aria-label="Products pagination">
            <a href="#">&laquo;</a>
            <span class="active">1</span>
            <a href="#">2</a>
            <a href="#">&raquo;</a>
          </nav>
        </div>

        <div class="delete-modal" data-delete-modal aria-hidden="true">
          <div class="delete-modal__backdrop" data-delete-close></div>
          <div
            class="delete-modal__dialog"
            role="dialog"
            aria-modal="true"
            aria-labelledby="delete-modal-title"
          >
            <div class="delete-modal__icon">
              <i class="fa-solid fa-triangle-exclamation"></i>
            </div>
            <h3 id="delete-modal-title">Delete product?</h3>
            <p class="delete-modal__message" data-delete-modal-message>
              This product will be removed from the inventory.
            </p>
            <div class="delete-modal__actions">
              <button type="button" class="btn btn-secondary" data-delete-close>
                Cancel
              </button>
              <button type="button" class="btn btn-danger" data-delete-confirm>
                Delete product
              </button>
            </div>
          </div>
        </div>
      </main>

      <script>
        (() => {
          const modal = document.querySelector('[data-delete-modal]');
          if (!modal) {
            return;
          }

          const message = modal.querySelector('[data-delete-modal-message]');
          const confirmButton = modal.querySelector('[data-delete-confirm]');
          const deleteButtons = document.querySelectorAll('[data-delete-trigger]');
          const closeTargets = modal.querySelectorAll('[data-delete-close]');

          let activeForm = null;

          const openModal = (form, productTitle) => {
            activeForm = form;
            message.textContent = `Are you sure you want to delete “${productTitle}”? This cannot be undone.`;
            modal.classList.add('is-open');
            modal.setAttribute('aria-hidden', 'false');
            document.body.classList.add('modal-open');
            confirmButton.focus();
          };

          const closeModal = () => {
            activeForm = null;
            modal.classList.remove('is-open');
            modal.setAttribute('aria-hidden', 'true');
            document.body.classList.remove('modal-open');
          };

          deleteButtons.forEach((button) => {
            button.addEventListener('click', (event) => {
              event.preventDefault();
              const form = button.closest('form');
              if (!form) {
                return;
              }

              openModal(form, button.dataset.productTitle || 'this product');
            });
          });

          closeTargets.forEach((target) => {
            target.addEventListener('click', closeModal);
          });

          confirmButton.addEventListener('click', () => {
            if (activeForm) {
              activeForm.submit();
            }
          });

          document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape' && modal.classList.contains('is-open')) {
              closeModal();
            }
          });
        })();
      </script>

<%- include('includes/end.ejs') %>