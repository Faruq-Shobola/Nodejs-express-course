<%- include('includes/head.ejs') %>

<%- include('includes/sidebar.ejs') %>

      <!-- ========== ADMIN MAIN CONTENT ========== -->
      <main class="admin-main">
        <!-- Top Bar -->
        <div class="admin-topbar">
          <h1>Manage Orders</h1>
          <div class="admin-user">
            <span>Welcome, <strong>Admin</strong></span>
            <div class="admin-avatar">A</div>
          </div>
        </div>

        <!-- Orders Filters & Actions -->
        <div class="admin-card mb-4">
          <div class="flex justify-between items-center flex-wrap gap-3">
            <div class="flex gap-2 items-center">
              <div class="search-box">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" placeholder="Search orders..." style="padding: 0.5rem 1rem 0.5rem 2.5rem; border: 1px solid var(--border); border-radius: var(--radius); outline: none;" />
              </div>
              <select style="padding: 0.5rem 1rem; border: 1px solid var(--border); border-radius: var(--radius); outline: none; background: white;">
                <option value="">All Status</option>
                <option value="processing">Processing</option>
                <option value="shipped">Shipped</option>
                <option value="delivered">Delivered</option>
                <option value="cancelled">Cancelled</option>
              </select>
            </div>
            <div class="flex gap-2">
              <button class="btn btn-outline btn-sm">
                <i class="fa-solid fa-download"></i> Export CSV
              </button>
              <button class="btn btn-primary btn-sm">
                <i class="fa-solid fa-print"></i> Print Labels
              </button>
            </div>
          </div>
        </div>

        <!-- Orders Table -->
        <div class="admin-card">
          <div class="table-responsive">
            <table class="data-table">
              <thead>
                <tr>
                  <th><input type="checkbox" /></th>
                  <th>Order ID</th>
                  <th>Date</th>
                  <th>Customer</th>
                  <th>Items</th>
                  <th>Total</th>
                  <th>Status</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% if (orders && orders.length > 0) { %>
                  <% for (let order of orders) { %>
                    <% 
                      let totalItems = order.products.reduce((acc, p) => acc + p.quantity, 0);
                      let orderTotal = order.products.reduce((acc, p) => acc + (p.quantity * (p.product.price || 0)), 0);
                      let orderDate = order.createdAt ? new Date(order.createdAt).toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric' }) : 'Recent';
                    %>
                    <tr>
                      <td><input type="checkbox" /></td>
                      <td><strong>#ORD-<%= order._id.toString().slice(-4).toUpperCase() %></strong></td>
                      <td><%= orderDate %></td>
                      <td>
                        <div style="font-weight: 500;"><%= order.user.name %></div>
                        <small class="text-muted"><%= (order.user.userId && order.user.userId.email) ? order.user.userId.email : '' %></small>
                      </td>
                      <td><%= totalItems %> <%= totalItems === 1 ? 'Item' : 'Items' %></td>
                      <td><strong>$<%= orderTotal.toFixed(2) %></strong></td>
                      <td><span class="stock-badge in-stock">Completed</span></td>
                      <td>
                        <div class="flex gap-1">
                          <button class="btn btn-outline btn-sm" title="View Details"><i class="fa-solid fa-eye"></i></button>
                          <button class="btn btn-outline btn-sm" title="Edit Order"><i class="fa-solid fa-pen"></i></button>
                        </div>
                      </td>
                    </tr>
                  <% } %>
                <% } else { %>
                  <tr>
                    <td colspan="8" style="text-align: center; padding: 3rem 1rem;">
                      <i class="fa-solid fa-box-open" style="font-size: 2.5rem; color: var(--text-muted); margin-bottom: 0.75rem; display: block;"></i>
                      <h3 style="color: var(--text-main); margin-bottom: 0.25rem;">No Orders Found</h3>
                      <p class="text-muted" style="margin: 0;">When customers place orders from their cart, they will show up here.</p>
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>

          <!-- Pagination -->
          <div class="pagination mt-4">
            <a href="#"><i class="fa-solid fa-chevron-left"></i></a>
            <span class="active">1</span>
            <a href="#">2</a>
            <a href="#">3</a>
            <a href="#"><i class="fa-solid fa-chevron-right"></i></a>
          </div>
        </div>
      </main>

<%- include('includes/end.ejs') %>